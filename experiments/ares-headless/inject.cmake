# Inject only an opt-in frontend target; upstream remains the top-level source.
if(PROJECT_NAME STREQUAL "ares" AND NOT SC64_PROBE_INJECTED)
  set(SC64_PROBE_INJECTED TRUE)
  function(sc64_add_probe)
    add_executable(sc64-ares-headless "${SC64_PROBE_SOURCE}")
    target_compile_features(sc64-ares-headless PRIVATE cxx_std_20)
    target_compile_definitions(sc64-ares-headless PRIVATE MIA_LIBRARY)
    if(SC64_RESULT_TRACE)
      target_compile_definitions(sc64-ares-headless PRIVATE SC64_RESULT_TRACE)
    endif()
    target_include_directories(sc64-ares-headless PRIVATE "${CMAKE_SOURCE_DIR}" "${CMAKE_SOURCE_DIR}/ares" "${CMAKE_SOURCE_DIR}/nall" "${CMAKE_SOURCE_DIR}/thirdparty" "${CMAKE_BINARY_DIR}")
    target_link_libraries(sc64-ares-headless PRIVATE ares::ares ares::mia ares::nall)
    get_filename_component(sc64_moltenvk_dir "${MoltenVK_LIBRARY}" DIRECTORY)
    set_target_properties(sc64-ares-headless PROPERTIES BUILD_RPATH "${sc64_moltenvk_dir}")
  endfunction()
  cmake_language(DEFER CALL sc64_add_probe)
endif()
