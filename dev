def weapon_source_input_ready(path: Path) -> bool:
    """Require source selectors, frame payload, and effect LUT bytes."""
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError):
        return False
    return (re.search(r"^#define\s+SC64_WEAPON_SOURCE_BANK_VERSION\s+1\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_WEAPON_SOURCE_METADATA\s+1\s*$",
                      text, re.MULTILINE) is not None and
            all(f"{accessor}(" in text for accessor in (
                "sc64_weapon_source_profile_lookup",
                "sc64_weapon_source_image_lookup",
                "sc64_weapon_source_frame_lookup",
                "sc64_weapon_source_frame_pixels",
                "sc64_weapon_source_animation_lookup",
                "sc64_weapon_source_lut_for_image")) and
            re.search(r"static const uint8_t sc64_weapon_source_pixels\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"static const uint8_t sc64_weapon_source_lut_bytes\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"^#define\s+SC64_WEAPON_SOURCE_PROFILE_COUNT\s+[1-9]\d*\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_WEAPON_SOURCE_FRAME_COUNT\s+[1-9]\d*\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_WEAPON_SOURCE_IMAGE_COUNT\s+[1-9]\d*\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_WEAPON_SOURCE_ANIMATION_COUNT\s+[1-9]\d*\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_WEAPON_SOURCE_LUT_COUNT\s+[1-9]\d*\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"static const Sc64WeaponSourceAttackProfile sc64_weapon_source_profiles\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"static const Sc64WeaponSourceImage sc64_weapon_source_images\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"static const Sc64WeaponSourceFrame sc64_weapon_source_frames\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"static const Sc64WeaponSourceAnimation sc64_weapon_source_animations\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"static const Sc64WeaponSourceLut sc64_weapon_source_luts\[[1-9]\d*\]",
                      text) is not None)


def death_source_input_ready(path: Path) -> bool:
    """Require a populated, versioned source death-animation bank."""
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError):
        return False
    return (re.search(r"^#define\s+SC64_DEATH_SOURCE_BANK_VERSION\s+2u?\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_DEATH_SOURCE_METADATA_VERSION\s+1u?\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_DEATH_SOURCE_PIXEL_BYTES\s+[1-9]\d*u?\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_DEATH_SOURCE_ACTOR_COUNT\s+[1-9]\d*u?\s*$",
                      text, re.MULTILINE) is not None and
            "sc64_death_image_frame(" in text and
            "sc64_death_source(" in text and
            re.search(r"static const Sc64DeathSource sc64_death_raw_\d+\s*=", text) is not None and
            re.search(r"static const unsigned char sc64_death_image_\d+_frame_\d+_pixels\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"^#define\s+SC64_DEATH_SOURCE_WORD_METADATA\s+1u?\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_DEATH_SOURCE_WORD_BYTES\s+[1-9]\d*u?\s*$",
                      text, re.MULTILINE) is not None and
            "sc64_death_image_word_frame(" in text and
            all(re.search(
                rf"static const u32 sc64_death_image_\d+_frame_\d+_words_p{phase}\[[1-9]\d*\]",
                text) is not None for phase in range(4)) and
            re.search(r"static const GbaSpriteWordFrame sc64_death_image_\d+_frame_\d+_words\s*=",
                      text) is not None)


def construction_color_input_ready(path: Path) -> bool:
    """Reject old opaque Warp Anchor banks before invoking the compiler."""
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError):
        return False
    return (re.search(r"^#define\s+SC64_CONSTRUCTION_COLOR_MODIFIERS_VERSION\s+1u?\s*$",
                      text, re.MULTILINE) is not None and
            "sc64_construction_modifier_frame(" in text and
            "sc64_construction_modifier_lookup(" in text and
            re.search(r"static const unsigned char \w*211_strengths_\d+\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"static const unsigned char \w*(?:lookup|lut)\w*\[(?:10240|40\s*\*\s*256)\]",
                      text) is not None)


def tank_vfx_input_ready(path: Path) -> bool:
    """Require versioned source-effect frames and a destination lookup table."""
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError):
        return False
    return (re.search(r"^#define\s+SC64_TANK_SOURCE_VFX_VERSION\s+1\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"static const Sc64TankSourceFrame sc64_tank_frames_533\[14\]",
                      text) is not None and
            re.search(r"static const uint8_t sc64_tank_source_pixels\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"static const uint8_t sc64_tank_projected_lut\[63\s*\*\s*256\]",
                      text) is not None)


def canonical_zerg_input_ready(label: str, path: Path) -> bool:
    """Check that canonical Zerg has all authenticated Z4 compile inputs."""
    for expected_label, _, marker in CANONICAL_ZERG_INPUTS:
        if label != expected_label:
            continue
        if not path.is_file():
            return False
        if expected_label == "Zerg chapter 4 maps":
            return (race_campaign_input_ready("zerg", path) and
                    race_campaign_input_ready("zerg-z4", path))
        if expected_label == "Zerg chapter 4 sprites":
            return unit_word_sprite_input_ready(path, marker)
        if marker is None:
            return True
        try:
            if expected_label.endswith("authenticated source"):
                manifest = json.loads(path.read_text(encoding="ascii"))
                return (manifest.get("schema") == 1 and
                        manifest.get("mission") == {
                            "id": "Z4", "global_catalog_index": 15,
                            "source_map_path": "008/017"})
            return marker in path.read_text(encoding="ascii")
        except (OSError, UnicodeError, json.JSONDecodeError):
            return False
    return path.is_file()


def canonical_zerg_z6_input_ready(label: str, path: Path) -> bool:
    """Check canonical Z1-Z6 chapter programs and the packed sprite payload."""
    for expected_label, _, marker in CANONICAL_ZERG_Z6_INPUTS:
        if label != expected_label:
            continue
        if not path.is_file():
            return False
        if expected_label == "Zerg six-chapter sprites":
            return (unit_word_sprite_input_ready(path, marker) and
                    unit_word_sprite_input_ready(path, "SC64_Z5_DOODAD_SPRITE_SET_COMPLETE"))
        try:
            return marker in path.read_text(encoding="ascii")
        except (OSError, UnicodeError):
            return False
    return path.is_file()


def protoss_p4_input_ready(label: str, path: Path) -> bool:
    """Authenticate the fourth chapter without trusting file existence alone."""
    for expected_label, _, marker in PROTOSS_P4_INPUTS:
        if label != expected_label:
            continue
        if not path.is_file():
            return False
        if expected_label.endswith("maps"):
            return (race_campaign_input_ready("protoss-p3", path) and
                    race_campaign_input_ready("protoss-p4-storm", path))
        if expected_label.endswith("sprites"):
            return unit_word_sprite_input_ready(path, marker)
        try:
            if expected_label.endswith("authenticated source"):
                manifest = json.loads(path.read_text(encoding="ascii"))
                return (manifest.get("schema") == 1 and manifest.get("mission") == {
                    "id": "P4", "global_catalog_index": 23,
                    "source_map_path": "008/021"})
            text = path.read_text(encoding="ascii")
            if expected_label.endswith("scenario"):
                return (marker in text and
                        re.search(r"^#define\s+SC64_P4_CREATE_PREFIX_VERSION\s+1\s*$",
                                  text, re.MULTILINE) is not None and
                        re.search(r"\bsc64_p4_source_create_prefix\s*\[", text) is not None)
            return marker in text
        except (OSError, UnicodeError, json.JSONDecodeError):
            return False
    return path.is_file()


