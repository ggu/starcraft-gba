def race_campaign_input_ready(profile: str, header: Path) -> bool:
    """Check that generated source retains the opt-in map gate and payload."""
    gate = RACE_CAMPAIGN_GATES.get(profile)
    if gate is None or not header.is_file():
        return False
    text = header.read_text(encoding="utf-8")
    opening = f"#if defined(SC64_UNIFIED) && defined({gate[0]})"
    closing = f"#endif /* SC64_UNIFIED && {gate[0]} */"
    start = text.find(opening)
    if start < 0:
        return False
    end = text.find(closing, start + len(opening))
    return end >= 0 and gate[1] in text[start:end]


def staged_campaign_input_ready(profile: str, label: str, path: Path) -> bool:
    """Check staged profile headers as well as their existence."""
    for required_label, relative, marker in STAGED_CAMPAIGN_INPUTS.get(profile, ()):
        if required_label != label:
            continue
        if not path.is_file():
            return False
        if marker is None:
            return True
        try:
            if profile == "protoss-p6" and label == "Protoss chapter 6 scenario":
                text = path.read_text(encoding="ascii")
                return (re.search(r"^#define\s+SC64_P6_SOURCE_GLOBAL_ID\s+25u\s*$",
                                  text, re.MULTILINE) is not None and
                        re.search(r"static const Sc64P6SourceAction sc64_p6_source_actions\[[1-9][0-9]*\]",
                                  text) is not None)
            if profile == "protoss-p6" and label == "Protoss chapter 6 abilities":
                text = path.read_text(encoding="ascii")
                return ("#define SC64_P6_ABILITIES_COMPLETE 1u" in text and
                        "#define SC64_P6_ABILITIES_SOURCE_GLOBAL_ID 25u" in text)
            if profile == "protoss-p6" and label == "Protoss chapter 6 doodads":
                text = path.read_text(encoding="ascii")
                return (re.search(r"^#define\s+SC64_P6_DOODAD_SOURCE_COUNT\s+[1-9][0-9]*u\s*$",
                                  text, re.MULTILINE) is not None and
                        re.search(r"static const Sc64P6Doodad sc64_p6_doodads\[",
                                  text) is not None)
            if profile in ("protoss-p5-shuttle", "protoss-p6") and label == "Protoss chapter 5 sprites":
                return unit_word_sprite_input_ready(path, marker)
            if profile == "protoss-p6" and label == "Protoss chapter 6 sprites":
                return unit_word_sprite_input_ready(path, marker)
            if profile == "protoss-p7" and label == "Protoss chapter 7 scenario":
                text = path.read_text(encoding="ascii")
                return (re.search(r"^#define\s+SC64_P7_SOURCE_GLOBAL_ID\s+26u\s*$",
                                  text, re.MULTILINE) is not None and
                        re.search(r"static const Sc64P7SourceAction sc64_p7_source_actions\[[1-9][0-9]*\]",
                                  text) is not None)
            if profile == "protoss-p7" and label == "Protoss chapter 7 Battery properties":
                text = path.read_text(encoding="ascii")
                return ("#define SC64_P7_BATTERY_SOURCE_CHK_SHA256 \"" in text and
                        "sc64_p7_battery_source_properties[2]" in text)
            if profile == "protoss-p7" and label == "Protoss seven-chapter sprites":
                return unit_word_sprite_input_ready(path, marker)
            return marker in path.read_text(encoding="ascii")
        except (OSError, UnicodeError):
            return False
    return path.is_file()


def unit_word_sprite_input_ready(path: Path, group_marker: str | None = None) -> bool:
    """Require an actual packed payload, not just a stale generator marker."""
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError):
        return False
    return ((group_marker is None or group_marker in text) and
            re.search(r"^#define\s+SC64_RACE_UNIT_WORD_SPRITE_METADATA\s+1\s*$",
                      text, re.MULTILINE) is not None and
            "sc64_race_unit_words_sprite(" in text and
            re.search(r"static const GbaSpriteWordFrame sc64_race_unit_words_\d+ =",
                      text) is not None and
            re.search(r"static const u32 sc64_race_unit_words_\d+_p[0-3]\[",
                      text) is not None)


def facing_sprite_input_ready(path: Path) -> bool:
    """Require the metadata-aware directional bank and real frame payload."""
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError):
        return False
    return (re.search(r"^#define\s+SC64_UNIT_FACING_BANK_VERSION\s+2\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_UNIT_FACING_DIRECTIONAL_METADATA\s+1\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_UNIT_FACING_WORD_METADATA\s+1\s*$",
                      text, re.MULTILINE) is not None and
            "sc64_unit_facing_frames(" in text and
            "sc64_unit_facing_word_frame(" in text and
            re.search(r"static const GbaSpriteWordFrame sc64_unit_facing_\d+_word_\d+\s*=",
                      text) is not None and
            re.search(r"static const u32 sc64_unit_facing_\d+_word_\d+_p0\[[1-9]\d*\]",
                      text) is not None and
            re.search(r"static const Sc64SpriteFrame sc64_unit_facing_\d+\[17\]",
                      text) is not None and
            re.search(r"static const unsigned char sc64_unit_facing_\d+_0_pixels\[[1-9]\d*\]",
                      text) is not None)


def walk_cycle_input_ready(path: Path) -> bool:
    """Require the 32-heading walk-cycle bank with at least one cycle."""
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError):
        return False
    return (re.search(r"^#define\s+SC64_UNIT_WALK_BANK_VERSION\s+1\s*$",
                      text, re.MULTILINE) is not None and
            re.search(r"^#define\s+SC64_UNIT_WALK_HEADINGS\s+32u\s*$",
                      text, re.MULTILINE) is not None and
            "sc64_unit_walk_cycle(" in text and
            re.search(r"static const Sc64UnitWalkCycle sc64_unit_walk_i\d+ =",
                      text) is not None)


