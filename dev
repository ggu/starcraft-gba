def locate_mgba() -> str | None:
    configured = os.environ.get("MGBA")
    if configured:
        candidate = shutil.which(configured) or configured
        if Path(candidate).is_file() and os.access(candidate, os.X_OK):
            return candidate
        raise RuntimeError(f"MGBA is set but does not name an executable: {configured}")
    for name in ("mGBA", "mgba"):
        candidate = shutil.which(name)
        if candidate:
            return candidate
    for fallback in (Path.home() / "Applications/mGBA.app/Contents/MacOS/mGBA",
                     Path("/Applications/mGBA.app/Contents/MacOS/mGBA")):
        if fallback.is_file() and os.access(fallback, os.X_OK):
            return str(fallback)
    return None


def doctor(require_emulator: bool = False) -> int:
    prefix = os.environ.get("PREFIX", "arm-none-eabi-")
    checks = [
        ("ARM GCC", shutil.which(prefix + "gcc")),
        ("ARM objcopy", shutil.which(prefix + "objcopy")),
        ("ARM size", shutil.which(prefix + "size")),
        ("Make", shutil.which("make")),
        ("Clang", shutil.which(os.environ.get("CLANG", "clang"))),
        ("Python 3.10+", sys.executable if sys.version_info >= (3, 10) else None),
        ("Git", shutil.which("git")),
    ]
    failed = False
    for label, path in checks:
        if path:
            print(f"OK      {label}: {path}")
        else:
            print(f"MISSING {label}")
            failed = True
    emulator_error = "not installed; needed only for play/emulator checks"
    try:
        emulator = locate_mgba()
    except RuntimeError as error:
        emulator = None
        emulator_error = str(error)
    if emulator:
        print(f"OK      mGBA: {emulator}")
    else:
        print(f"{'MISSING' if require_emulator else 'OPTIONAL'} mGBA: {emulator_error}")
        failed |= require_emulator
    return int(failed)


def build(game: str) -> None:
    if game == "terran" and not unit_word_sprite_input_ready(
            ROOT / ".local/sc64/terran-late/import-stage/sc64_race_sprites_generated.h"):
        raise RuntimeError(
            "canonical Terran requires prepacked unit-word sprite metadata; "
            "regenerate it with ./dev sc64 prepare --rom PATH --profile terran")
    if game in ("zerg", "zerg-z6", "zerg-z7", "zerg-z4") and not canonical_zerg_input_ready(
            "Zerg chapter 4 sprites",
            ROOT / ".local/sc64/zp-stage/generated/sc64_race_sprites_generated.h"):
        raise RuntimeError(
            "canonical Zerg requires prepacked unit-word sprite metadata; "
            f"regenerate it with ./dev sc64 prepare --rom PATH --profile {game}")
    if game in ("zerg", "zerg-z6", "zerg-z7"):
        missing = [label for label, relative, _ in CANONICAL_ZERG_Z6_INPUTS
                   if not canonical_zerg_z6_input_ready(label, ROOT / relative)]
        if missing or not race_campaign_input_ready(
                "zerg-z6", ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"):
            raise RuntimeError(
                "canonical Zerg Z1-Z6 requires authenticated chapter 5/6 inputs: " +
                ", ".join(missing or ["the SC64_Z6_DATA_ENABLED map gate"]) +
                "; regenerate with ./dev sc64 prepare --rom PATH --profile " + game)
    if game == "zerg-z7":
        z7_missing = [label for label, relative, _ in STAGED_CAMPAIGN_INPUTS["zerg-z7"]
                      if not staged_campaign_input_ready("zerg-z7", label, ROOT / relative)]
        if (z7_missing or not race_campaign_input_ready(
                "zerg-z7", ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h")):
            raise RuntimeError(
                "canonical Zerg Z7 requires the authenticated chapter input and map gate: " +
                ", ".join(z7_missing or ["the SC64_Z7_DATA_ENABLED map gate"]) +
                "; regenerate with ./dev sc64 prepare --rom PATH --profile zerg-z7")
    if game in ("protoss", "protoss-p6", "protoss-p7", "protoss-p4-storm"):
        missing = [label for label, relative, _ in PROTOSS_P4_INPUTS
                   if not protoss_p4_input_ready(label, ROOT / relative)]
        if missing:
            raise RuntimeError(
                "Protoss P4 requires authenticated chapter inputs: " + ", ".join(missing) +
                "; prepare them with ./dev sc64 prepare --rom PATH --profile " +
                ("protoss" if game in ("protoss", "protoss-p6", "protoss-p7") else "protoss-p4-storm"))
    if game in ("protoss", "protoss-p6", "protoss-p7"):
        p5_maps = ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"
        if not race_campaign_input_ready("protoss-p5-shuttle", p5_maps):
            raise RuntimeError("canonical Protoss requires the P5 map gate; regenerate with ./dev sc64 prepare --rom PATH --profile protoss")
        p5_sprite = ROOT / ".local/sc64/p5/generated/sc64_race_sprites_generated.h"
        p5_missing = [label for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p5-shuttle"]
                      if not staged_campaign_input_ready("protoss-p5-shuttle", label, ROOT / relative)]
        if p5_missing or not unit_word_sprite_input_ready(
                p5_sprite, "SC64_Z6_SPRITE_SET_COMPLETE"):
            detail = ", ".join(p5_missing or ["Protoss chapter 5 prepacked unit-word sprites"])
            raise RuntimeError(
                "canonical Protoss P5 requires authenticated chapter inputs: " + detail +
                "; regenerate with ./dev sc64 prepare --rom PATH --profile protoss")
        p6_missing = [label for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p6"]
                      if not staged_campaign_input_ready("protoss-p6", label, ROOT / relative)]
        if (p6_missing or
                not race_campaign_input_ready("protoss-p6", p5_maps)):
            raise RuntimeError(
                "canonical Protoss P6 requires authenticated chapter inputs: " +
                ", ".join(p6_missing or ["the SC64_P6_DATA_ENABLED map gate"]) +
                "; regenerate with ./dev sc64 prepare --rom PATH --profile protoss")
        if game in ("protoss", "protoss-p7"):
            p7_missing = [label for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p7"]
                          if not staged_campaign_input_ready("protoss-p7", label, ROOT / relative)]
            if (p7_missing or
                    not race_campaign_input_ready("protoss-p7", p5_maps)):
                raise RuntimeError(
                    "canonical Protoss P7 requires authenticated chapter inputs: " +
                    ", ".join(p7_missing or ["the SC64_P7_DATA_ENABLED map gate"]) +
                    "; regenerate with ./dev sc64 prepare --rom PATH --profile protoss-p7")
    if game in FACING_PROFILES and not facing_sprite_input_ready(ROOT / FACING_HEADER):
        raise RuntimeError(
            "canonical race builds require the metadata-aware directional sprite bank; "
            "regenerate with ./dev sc64 prepare --rom PATH --profile " + game)
    if game in FACING_PROFILES and not tank_vfx_input_ready(ROOT / TANK_VFX_HEADER):
        raise RuntimeError(
            "canonical race builds require source Tank effects; "
            "regenerate with ./dev sc64 prepare --rom PATH --profile " + game)
    if game in FACING_PROFILES and not attack_pose_input_ready(ROOT / ATTACK_POSE_HEADER):
        raise RuntimeError(
            "canonical race builds require source attack-pose data; "
            "regenerate with ./dev sc64 prepare --rom PATH --profile " + game)
    if game in FACING_PROFILES and not weapon_source_input_ready(ROOT / WEAPON_SOURCE_HEADER):
        raise RuntimeError(
            "canonical race builds require source weapon VFX data; "
            "regenerate with ./dev sc64 prepare --rom PATH --profile " + game)
    if game in FACING_PROFILES and not death_source_input_ready(ROOT / DEATH_SOURCE_HEADER):
        raise RuntimeError(
            "canonical race builds require source death-art data; "
            "regenerate with ./dev sc64 prepare --rom PATH --profile " + game)
    if game in CONSTRUCTION_PROFILES and not construction_color_input_ready(ROOT / CONSTRUCTION_HEADER):
        raise RuntimeError(
            "source construction art requires the blue-glow modifier bank; "
            "regenerate with ./dev sc64 prepare --rom PATH --profile " + game)
    if game in CONSTRUCTION_PROFILES and not (facing_sprite_input_ready(ROOT / FACING_HEADER) and
                                              walk_cycle_input_ready(ROOT / WALK_HEADER)):
        raise RuntimeError(
            "race-engine builds require the directional sprite and walk-cycle banks; "
            "regenerate with ./dev sc64 prepare --rom PATH --profile " + game)
    make_target, _ = GAMES[game]
    run(["make", make_target])


def play(game: str) -> int:
    build(game)
    _, relative_rom = GAMES[game]
    rom = ROOT / relative_rom
    if not rom.is_file():
        raise RuntimeError(f"Expected ROM was not built: {rom}")
    mgba = locate_mgba()
    if not mgba:
        raise RuntimeError("mGBA was not found; install it or set MGBA to its executable path")

    # Keep the existing Z3 save directory attached to the explicit legacy
    # profile; the canonical Z4 has a distinct ROM and save location.
    save_profile = PLAY_SAVE_PROFILES.get(game, game)
    local = ROOT / ".local" / "play" / save_profile
    saves, states, screenshots = (local / name for name in ("saves", "states", "screenshots"))
    for directory in (saves, states, screenshots):
        directory.mkdir(parents=True, exist_ok=True)
    log_path = local / "mgba.log"
    command = [mgba, "-C", f"savegamePath={saves}", "-C", f"savestatePath={states}",
               "-C", f"screenshotPath={screenshots}", str(rom)]
    with log_path.open("ab") as log:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                   stdout=log, stderr=subprocess.STDOUT,
                                   start_new_session=True, close_fds=True)
    print(f"Launched {game} in mGBA (PID {process.pid})")
    print(f"ROM: {rom}\nLog: {log_path}")
    return 0


def ensure_extractor() -> None:
    if REFERENCE.exists():
        if not (REFERENCE / ".git").is_dir():
            raise RuntimeError(f"Reference path exists but is not a Git checkout: {REFERENCE}")
        head = subprocess.check_output(["git", "-C", str(REFERENCE), "rev-parse", "HEAD"], text=True).strip()
        dirty = subprocess.check_output(["git", "-C", str(REFERENCE), "status", "--porcelain"], text=True).strip()
        if head != REFERENCE_COMMIT or dirty:
            raise RuntimeError(f"{REFERENCE} must be clean at {REFERENCE_COMMIT}; found {head}" +
                               (" with local edits" if dirty else ""))
        return
    REFERENCE.parent.mkdir(parents=True, exist_ok=True)
    run(["git", "clone", "--no-checkout", REFERENCE_URL, str(REFERENCE)])
    run(["git", "-C", str(REFERENCE), "checkout", "--detach", REFERENCE_COMMIT])
    head = subprocess.check_output(["git", "-C", str(REFERENCE), "rev-parse", "HEAD"], text=True).strip()
    dirty = subprocess.check_output(["git", "-C", str(REFERENCE), "status", "--porcelain"], text=True).strip()
    if head != REFERENCE_COMMIT or dirty:
        raise RuntimeError(f"Pinned extractor checkout verification failed: {head}")


def prepare(rom: Path, profile: str) -> None:
    rom = rom.expanduser().resolve()
    if not rom.is_file():
        raise RuntimeError(f"User-supplied ROM does not exist: {rom}")
    ensure_extractor()
    base_profile = "wasteland" if profile == "wasteland" else "backwater"
    run([sys.executable, str(ROOT / "tools/sc64_workspace.py"), "prepare",
         "--rom", str(rom), "--profile", base_profile])
    private_rom = ROOT / ".local/sc64/rom/StarCraft64-USA.z64"
    # Sound effects and music for every imported profile (optional at build time).
    run([sys.executable, str(ROOT / "tools/sc64_audio_pack.py"), "--rom", str(private_rom)])
    if profile == "campaign":
        run([sys.executable, str(ROOT / "tools/sc64_campaign_pack.py"), "--rom", str(private_rom)])
    elif profile in ("races", "unified", "terran", "zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe",
                     "zerg-z4", "zerg-z3", "protoss", "protoss-p7", "protoss-p3", "protoss-p4-storm",
                     "protoss-p5-shuttle", "protoss-p6"):
        run([sys.executable, str(ROOT / "tools/sc64_races_pack.py")])
        if profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z4", "zerg-z3",
                       "protoss", "protoss-p6", "protoss-p7", "protoss-p3"):
            header = ROOT / ".local/sc64/races/generated/sc64_races_generated.h"
            gate_profile = ("zerg" if profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe",
                                                    "zerg-z3", "zerg-z4") else
                            "protoss" if profile == "protoss-p6" else
                            "protoss-p7" if profile == "protoss-p7" else profile)
            if not race_campaign_input_ready(gate_profile, header):
                raise RuntimeError(f"generated race data is missing the {RACE_CAMPAIGN_GATES[gate_profile][0]} map gate")
        if profile in STAGED_CAMPAIGN_INPUTS and profile not in ("zerg-z6", "zerg-z7"):
            stage = ROOT / ".local/sc64/zp-stage/generated"
            run([sys.executable, str(ROOT / "tools/sc64_races_pack.py"), "--out",
                 str(stage / "sc64_races_generated.h")])
            if not race_campaign_input_ready(
                    profile, stage / "sc64_races_generated.h"):
                raise RuntimeError(f"generated staged race data is missing the {RACE_CAMPAIGN_GATES[profile][0]} map gate")
            run([sys.executable, str(ROOT / "tools/sc64_race_sprites.py"),
                 "--rom", str(private_rom), "--base-only", "--include-zp-campaign-actors",
                 "--prepack-unit-words",
                 "--out", str(stage / "sprites"),
                 "--header", str(stage / "sc64_race_sprites_generated.h")])
        run([sys.executable, str(ROOT / "tools/sc64_t4_scenario_pack.py")])
        run([sys.executable, str(ROOT / "tools/sc64_race_sprites.py"),
             "--prepack-unit-words"])
        run([sys.executable, str(ROOT / "tools/sc64_construction_sprites.py"),
             "--rom", str(private_rom)])
        if not construction_color_input_ready(ROOT / CONSTRUCTION_HEADER):
            raise RuntimeError("construction preparation produced a stale blue-glow bank")
        # Every race-engine product draws directional frames and walk cycles.
        run([sys.executable, str(ROOT / "tools/sc64_unit_facing.py"),
             "--rom", str(private_rom), "--out", str((ROOT / FACING_HEADER).parent)])
        if not facing_sprite_input_ready(ROOT / FACING_HEADER):
            raise RuntimeError("directional sprite preparation produced a stale or empty bank")
        run([sys.executable, str(ROOT / "tools/sc64_unit_walk_frames.py"),
             "--rom", str(private_rom), "--out", str((ROOT / WALK_HEADER).parent)])
        if not walk_cycle_input_ready(ROOT / WALK_HEADER):
            raise RuntimeError("walk-cycle preparation produced a stale or empty bank")
        run([sys.executable, str(ROOT / "tools/sc64_menu_assets.py")])
        run([sys.executable, str(ROOT / "tools/sc64_font_assets.py"),
             "--rom", str(private_rom)])
        run([sys.executable, str(ROOT / "tools/sc64_briefing_assets.py"),
             "--rom", str(private_rom)])
        run([sys.executable, str(ROOT / "tools/sc64_icon_assets.py"),
             "--rom", str(private_rom)])
        run([sys.executable, str(ROOT / "tools/sc64_chrome_assets.py"),
             "--rom", str(private_rom)])
        if profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z4",
                       "protoss", "protoss-p6", "protoss-p7", "protoss-p4-storm"):
            zerg = profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z4")
            faction = "Zerg" if zerg else "Protoss"
            chapter = "z4" if zerg else "p4"
            previous_profile = "zerg" if zerg else "protoss-p3"
            input_ready = canonical_zerg_input_ready if zerg else protoss_p4_input_ready
            stage = ROOT / ".local/sc64/zp-stage/generated"
            run([sys.executable, str(ROOT / "tools/sc64_races_pack.py"), "--out",
                 str(stage / "sc64_races_generated.h")])
            if not race_campaign_input_ready(previous_profile, stage / "sc64_races_generated.h"):
                raise RuntimeError(f"generated staged race data is missing the {RACE_CAMPAIGN_GATES[previous_profile][0]} map gate")
            run([sys.executable, str(ROOT / "tools/sc64_race_sprites.py"),
                 "--rom", str(private_rom), "--base-only", "--include-zp-campaign-actors",
                 "--prepack-unit-words",
                 "--out", str(stage / "sprites"),
                 "--header", str(stage / "sc64_race_sprites_generated.h")])
            run([sys.executable, str(ROOT / f"tools/sc64_{chapter}_pack.py"), "--rom", str(private_rom)])
            run([sys.executable, str(ROOT / f"tools/sc64_{chapter}_scenario_pack.py")])
            if not input_ready(
                    f"{faction} chapter 4 maps", stage / "sc64_races_generated.h"):
                raise RuntimeError(
                    f"generated staged race data is missing the {RACE_CAMPAIGN_GATES['zerg-z4' if zerg else 'protoss-p4-storm'][0]} map gate")
            if not input_ready(
                    f"{faction} chapter 4 sprites",
                    stage / "sc64_race_sprites_generated.h"):
                raise RuntimeError(
                    f"generated {faction} sprites are missing prepacked unit-word metadata; "
                    f"rerun ./dev sc64 prepare --rom PATH --profile {profile}")
        if profile in ("terran", "zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z4", "zerg-z3",
                       "protoss", "protoss-p7", "protoss-p3", "protoss-p4-storm", "protoss-p5-shuttle", "protoss-p6"):
            run([sys.executable, str(ROOT / "tools/sc64_skirmish_pack.py")])
        if profile in ("protoss", "protoss-p6", "protoss-p7"):
            prepare_staged_campaign("protoss-p5-shuttle", private_rom)
            p5_maps = ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"
            if not race_campaign_input_ready("protoss-p5-shuttle", p5_maps):
                raise RuntimeError("generated staged race data is missing the SC64_P5_DATA_ENABLED map gate")
            p5_sprite = ROOT / ".local/sc64/p5/generated/sc64_race_sprites_generated.h"
            if not unit_word_sprite_input_ready(p5_sprite, "SC64_Z6_SPRITE_SET_COMPLETE"):
                raise RuntimeError("generated P5 sprites lack prepacked word metadata; regenerate with ./dev sc64 prepare --rom PATH --profile protoss")
            prepare_staged_campaign("protoss-p6", private_rom)
            if not race_campaign_input_ready("protoss-p6", p5_maps):
                raise RuntimeError("generated staged race data is missing the SC64_P6_DATA_ENABLED map gate")
            p6_missing = [label for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p6"]
                          if not staged_campaign_input_ready("protoss-p6", label, ROOT / relative)]
            if p6_missing:
                raise RuntimeError("generated P6 inputs are incomplete: " + ", ".join(p6_missing))
            if profile in ("protoss", "protoss-p7"):
                prepare_staged_campaign("protoss-p7", private_rom)
                if not race_campaign_input_ready("protoss-p7", p5_maps):
                    raise RuntimeError("generated staged race data is missing the SC64_P7_DATA_ENABLED map gate")
                p7_missing = [label for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p7"]
                              if not staged_campaign_input_ready("protoss-p7", label, ROOT / relative)]
                if p7_missing:
                    raise RuntimeError("generated P7 inputs are incomplete: " + ", ".join(p7_missing))
        elif profile in ("zerg", "zerg-z6", "zerg-z7"):
            # Chapter 5/6 programs and banks as staged, then the canonical
            # word-packed inherited bank. Z7 adds its own staged program.
            prepare_staged_campaign("zerg-z6", private_rom)
            z6_maps = ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"
            if not race_campaign_input_ready("zerg-z6", z6_maps):
                raise RuntimeError("generated staged race data is missing the SC64_Z6_DATA_ENABLED map gate")
            bank = ROOT / ".local/sc64/zerg-z6/generated"
            run([sys.executable, str(ROOT / "tools/sc64_race_sprites.py"), "--rom", str(private_rom),
                 "--base-only", "--include-zp-campaign-actors", "--include-z5-actors",
                 "--include-z5-doodads", "--include-z6-actors", "--include-z6-buildings",
                 "--prepack-unit-words", "--out", str(bank / "sprites"),
                 "--header", str(bank / "sc64_race_sprites_generated.h")])
            missing = [label for label, relative, _ in CANONICAL_ZERG_Z6_INPUTS
                       if not canonical_zerg_z6_input_ready(label, ROOT / relative)]
            if missing:
                raise RuntimeError("canonical Zerg Z1-Z6 inputs are incomplete: " + ", ".join(missing) +
                                   "; regenerate with ./dev sc64 prepare --rom PATH --profile " + profile)
            if profile == "zerg-z7":
                prepare_staged_campaign("zerg-z7", private_rom)
                if not race_campaign_input_ready("zerg-z7", z6_maps):
                    raise RuntimeError("generated staged race data is missing the SC64_Z7_DATA_ENABLED map gate")
                z7_missing = [label for label, relative, _ in STAGED_CAMPAIGN_INPUTS["zerg-z7"]
                              if not staged_campaign_input_ready("zerg-z7", label, ROOT / relative)]
                if z7_missing:
                    raise RuntimeError("generated Z7 inputs are incomplete: " + ", ".join(z7_missing))
        elif profile in STAGED_CAMPAIGN_INPUTS and profile != "protoss-p6":
            prepare_staged_campaign(profile, private_rom)
        if profile == "terran":
            for mission in ("t5", "t6"):
                run([sys.executable, str(ROOT / "tools/sc64_t4_scenario_pack.py"),
                     "--profile", mission])
                run([sys.executable, str(ROOT / "tools/sc64_t5_availability.py"),
                     "--profile", mission])
            # The full profile uses its own sprite set so the smaller race ROMs
            # keep their existing generated inputs and memory limits.
            race = ROOT / ".local/sc64/races/generated"
            stage = ROOT / ".local/sc64/terran-late/import-stage"
            stage.mkdir(parents=True, exist_ok=True)
            names = ["sc64_races_generated.h"]
            names.extend(f"sc64_t{mission}_{kind}_generated.h"
                         for mission in range(7, 11)
                         for kind in ("scenario", "availability"))
            for name in names:
                shutil.copy2(race / name, stage / name)
            run([sys.executable, str(ROOT / "tools/sc64_race_sprites.py"),
                 "--include-t6", "--include-late-terran", "--prepack-unit-words",
                 "--out", str(stage / "sprites"),
                 "--header", str(stage / "sc64_race_sprites_generated.h")])
    if profile in FACING_PROFILES:
        run([sys.executable, str(ROOT / "tools/sc64_tank_source_vfx.py"),
             "--rom", str(private_rom), "--out", str((ROOT / TANK_VFX_HEADER).parent)])
        if not tank_vfx_input_ready(ROOT / TANK_VFX_HEADER):
            raise RuntimeError("Tank effect preparation produced a stale or empty bank")
        run([sys.executable, str(ROOT / "tools/sc64_unit_attack_sprites.py"),
             "--rom", str(private_rom),
             "--remap", str(ROOT / ".local/sc64/backwater/generated/palette-remap.bin"),
             "--out", str((ROOT / ATTACK_POSE_HEADER).parent),
             "--header", str(ROOT / ATTACK_POSE_HEADER)])
        if not attack_pose_input_ready(ROOT / ATTACK_POSE_HEADER):
            raise RuntimeError("attack-pose preparation produced a stale or empty bank")
        run([sys.executable, str(ROOT / "tools/sc64_weapon_source_sprites.py"),
             "--rom", str(private_rom),
             "--out", str((ROOT / WEAPON_SOURCE_HEADER).parent)])
        if not weapon_source_input_ready(ROOT / WEAPON_SOURCE_HEADER):
            raise RuntimeError("weapon VFX preparation produced a stale or empty bank")
        run([sys.executable, str(ROOT / "tools/sc64_death_sprites.py"),
             "--rom", str(private_rom),
             "--palette-remap", str(ROOT / ".local/sc64/backwater/generated/palette-remap.bin"),
             "--out", str((ROOT / DEATH_SOURCE_HEADER).parent),
             "--header", str(ROOT / DEATH_SOURCE_HEADER)])
        if not death_source_input_ready(ROOT / DEATH_SOURCE_HEADER):
            raise RuntimeError("source death-art preparation produced a stale or empty bank")
    print(f"Prepared local StarCraft 64 data for profile '{profile}'. Generated files stay under .local/.")


def status(profile: str) -> int:
    base = "wasteland" if profile == "wasteland" else "backwater"
    generated = ROOT / ".local/sc64" / ("generated" if base == "wasteland" else "backwater/generated")
    paths = [
        ("Verified USA ROM", ROOT / ".local/sc64/rom/StarCraft64-USA.z64"),
        ("Mission data", generated / "sc64_mission_generated.h"),
        ("Terrain and palette", generated / "sc64_assets_generated.h"),
        ("Sprite data", generated / "sc64_sprites_generated.h"),
    ]
    if profile == "campaign":
        paths.append(("Campaign data", ROOT / ".local/sc64/campaign/generated/sc64_campaign_generated.h"))
    if profile in CONSTRUCTION_PROFILES:
        race = ROOT / ".local/sc64/races/generated"
        paths.extend((label, race / name) for label, name in (
            ("Race maps", "sc64_races_generated.h"),
            ("Race sprites", "sc64_race_sprites_generated.h"),
            ("Menu artwork", "sc64_menu_generated.h"),
        ))
        paths.append(("Source construction art", ROOT / CONSTRUCTION_HEADER))
        paths.append(("Directional unit sprites", ROOT / FACING_HEADER))
        paths.append(("Unit walk cycles", ROOT / WALK_HEADER))
        paths.append(("Campaign briefings and portraits", ROOT /
                      ".local/sc64/briefings/generated/sc64_briefing_generated.h"))
        for label, name in (("Original interface fonts", "sc64_font_generated.h"),
                            ("Original interface icons", "sc64_icons_generated.h"),
                            ("Original menu chrome", "sc64_chrome_generated.h")):
            paths.append((label, ROOT / ".local/sc64/interface/generated" / name))
    if profile in ("terran", "zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z4", "zerg-z3",
                   "protoss", "protoss-p7", "protoss-p3", "protoss-p4-storm", "protoss-p5-shuttle", "protoss-p6"):
        paths.append(("Skirmish maps", ROOT / ".local/sc64/skirmish/generated/sc64_skirmish_generated.h"))
    if profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z4", "zerg-z3",
                   "protoss", "protoss-p6", "protoss-p7", "protoss-p3"):
        race_label = ("Protoss P6 gated map data" if profile == "protoss-p6" else
                      "Protoss P7 gated map data" if profile == "protoss-p7" else
                      "Zerg chapter 3 gated map data" if profile in
                      ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z4", "zerg-z3") else
                      f"{profile.title()} chapter 3 gated map data")
        paths.append((race_label, ROOT / ".local/sc64/races/generated/sc64_races_generated.h"))
    if profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z4"):
        paths.extend((label, ROOT / relative) for label, relative, _ in CANONICAL_ZERG_INPUTS)
    if profile in ("zerg", "zerg-z6", "zerg-z7"):
        paths.extend((label, ROOT / relative) for label, relative, _ in CANONICAL_ZERG_Z6_INPUTS)
        paths.append(("Zerg chapter 6 gated map data",
                      ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"))
        if profile == "zerg-z7":
            paths.append(("Zerg chapter 7 gated map data",
                          ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"))
    if profile in ("protoss", "protoss-p6", "protoss-p7", "protoss-p4-storm"):
        paths.extend((label, ROOT / relative) for label, relative, _ in PROTOSS_P4_INPUTS)
    if profile in ("protoss", "protoss-p7"):
        paths.extend((label, ROOT / relative) for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p6"])
        paths.append(("Protoss chapter 6 gated map data",
                      ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"))
        if profile == "protoss":
            paths.extend((label, ROOT / relative) for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p7"])
            paths.append(("Protoss P7 staged gated map data",
                          ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"))
    for label, relative, _ in STAGED_CAMPAIGN_INPUTS.get(profile, ()):
        paths.append((label, ROOT / relative))
    if profile in STAGED_CAMPAIGN_INPUTS and profile not in ("zerg-z6", "zerg-z7"):
        paths.append((f"{profile.title()} gated map data",
                      ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h"))
    if profile == "terran":
        race = ROOT / ".local/sc64/races/generated"
        stage = ROOT / ".local/sc64/terran-late/import-stage"
        paths.append(("Terran T4 triggers", race / "sc64_t4_scenario_generated.h"))
        paths.extend((f"Terran T{mission} {kind}", race / f"sc64_t{mission}_{kind}_generated.h")
                     for mission in (5, 6) for kind in ("scenario", "availability"))
        paths.extend((label, stage / name) for label, name in (
            ("Full Terran maps", "sc64_races_generated.h"),
            ("Full Terran sprites", "sc64_race_sprites_generated.h"),
        ))
        paths.extend((f"Terran T{mission} {kind}", stage / f"sc64_t{mission}_{kind}_generated.h")
                     for mission in range(7, 11) for kind in ("scenario", "availability"))
    if profile in FACING_PROFILES:
        paths.append(("Tank firing effects", ROOT / TANK_VFX_HEADER))
        paths.append(("Unit attack poses", ROOT / ATTACK_POSE_HEADER))
        paths.append(("Source weapon effects", ROOT / WEAPON_SOURCE_HEADER))
        paths.append(("Source death art", ROOT / DEATH_SOURCE_HEADER))
    _, rom_rel = GAMES[profile]
    paths.append(("Built ROM", ROOT / rom_rel))
    audio = ROOT / ".local/sc64/audio/generated/sc64_audio_generated.h"
    print(f"{'READY  ' if audio.is_file() else 'OPTIONAL'} Sound and music bank: {audio}")
    for label, path in paths:
        ready = path.is_file()
        if label == "Directional unit sprites":
            ready = facing_sprite_input_ready(path)
        elif label == "Tank firing effects":
            ready = tank_vfx_input_ready(path)
        elif label == "Unit attack poses":
            ready = attack_pose_input_ready(path)
        elif label == "Source weapon effects":
            ready = weapon_source_input_ready(path)
        elif label == "Source death art":
            ready = death_source_input_ready(path)
        elif label == "Source construction art":
            ready = construction_color_input_ready(path)
        elif label == "Unit walk cycles":
            ready = walk_cycle_input_ready(path)
        elif label.endswith("gated map data"):
            map_profile = ("protoss-p6" if label == "Protoss chapter 6 gated map data" or
                           label == "Protoss P6 gated map data" else
                           "protoss-p7" if label == "Protoss chapter 7 gated map data" or
                           label == "Protoss P7 gated map data" or
                           label == "Protoss P7 staged gated map data"
                           else "zerg-z6" if label in ("Zerg chapter 6 gated map data", "Zerg Z6 gated map data")
                           else "zerg-z7" if label == "Zerg chapter 7 gated map data"
                           else "zerg" if profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z3", "zerg-z4") else
                           "protoss" if profile == "protoss-p6" else profile)
            ready = race_campaign_input_ready(map_profile, path)
        elif any(label == item[0] for item in STAGED_CAMPAIGN_INPUTS.get(profile, ())):
            ready = staged_campaign_input_ready(profile, label, path)
        elif profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z4") and any(label == item[0] for item in CANONICAL_ZERG_INPUTS):
            ready = canonical_zerg_input_ready(label, path)
        elif profile in ("zerg", "zerg-z6", "zerg-z7") and any(label == item[0] for item in CANONICAL_ZERG_Z6_INPUTS):
            ready = canonical_zerg_z6_input_ready(label, path)
        elif profile in ("protoss", "protoss-p6", "protoss-p7", "protoss-p4-storm") and any(label == item[0] for item in PROTOSS_P4_INPUTS):
            ready = protoss_p4_input_ready(label, path)
        elif profile in ("protoss", "protoss-p6", "protoss-p7") and any(label == item[0] for item in STAGED_CAMPAIGN_INPUTS["protoss-p6"]):
            ready = staged_campaign_input_ready("protoss-p6", label, path)
        elif profile == "terran" and label == "Full Terran sprites":
            ready = unit_word_sprite_input_ready(path)
        note = (f" (run ./dev sc64 prepare --rom PATH --profile {profile} to regenerate unit-word metadata)"
                if profile in ("zerg", "zerg-z4") and label == "Zerg chapter 4 sprites" and not ready
                else "")
        if (profile in CONSTRUCTION_PROFILES and not ready and label in
                ("Directional unit sprites", "Unit walk cycles", "Tank firing effects",
                 "Unit attack poses", "Source weapon effects", "Source death art")):
            note = f" (run ./dev sc64 prepare --rom PATH --profile {profile} to regenerate)"
        print(f"{'READY  ' if ready else 'MISSING'} {label}: {path}{note}")
    return int(any(not path.is_file() for _, path in paths) or
               (profile in CONSTRUCTION_PROFILES and not facing_sprite_input_ready(ROOT / FACING_HEADER)) or
               (profile in CONSTRUCTION_PROFILES and not walk_cycle_input_ready(ROOT / WALK_HEADER)) or
               (profile in FACING_PROFILES and not tank_vfx_input_ready(ROOT / TANK_VFX_HEADER)) or
               (profile in FACING_PROFILES and not attack_pose_input_ready(ROOT / ATTACK_POSE_HEADER)) or
               (profile in FACING_PROFILES and not weapon_source_input_ready(ROOT / WEAPON_SOURCE_HEADER)) or
               (profile in FACING_PROFILES and not death_source_input_ready(ROOT / DEATH_SOURCE_HEADER)) or
               (profile in CONSTRUCTION_PROFILES and not construction_color_input_ready(ROOT / CONSTRUCTION_HEADER)) or
               (profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z4", "zerg-z3",
                            "protoss", "protoss-p6", "protoss-p7", "protoss-p3") and not race_campaign_input_ready(
                   "zerg" if profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z6-probe", "zerg-z3", "zerg-z4") else
                   "protoss" if profile == "protoss-p6" else profile,
                   ROOT / ".local/sc64/races/generated/sc64_races_generated.h")) or
               (profile in ("zerg", "zerg-z6", "zerg-z7", "zerg-z4") and any(not canonical_zerg_input_ready(
                   label, ROOT / relative) for label, relative, _ in CANONICAL_ZERG_INPUTS)) or
               (profile in ("zerg", "zerg-z6", "zerg-z7") and (
                   not race_campaign_input_ready("zerg-z6", ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h") or
                   any(not canonical_zerg_z6_input_ready(label, ROOT / relative)
                       for label, relative, _ in CANONICAL_ZERG_Z6_INPUTS))) or
               (profile == "zerg-z7" and (
                   not race_campaign_input_ready("zerg-z7", ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h") or
                   any(not staged_campaign_input_ready("zerg-z7", label, ROOT / relative)
                       for label, relative, _ in STAGED_CAMPAIGN_INPUTS["zerg-z7"]))) or
               (profile in ("protoss", "protoss-p6", "protoss-p7", "protoss-p4-storm") and any(not protoss_p4_input_ready(
                   label, ROOT / relative) for label, relative, _ in PROTOSS_P4_INPUTS)) or
               (profile in ("protoss", "protoss-p6", "protoss-p7") and (
                   not race_campaign_input_ready("protoss-p5-shuttle", ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h") or
                   not race_campaign_input_ready("protoss-p6", ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h") or
                   any(not staged_campaign_input_ready("protoss-p6", label, ROOT / relative)
                       for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p6"]))) or
               (profile in ("protoss", "protoss-p7") and (
                   not race_campaign_input_ready("protoss-p7", ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h") or
                   any(not staged_campaign_input_ready("protoss-p7", label, ROOT / relative)
                       for label, relative, _ in STAGED_CAMPAIGN_INPUTS["protoss-p7"]))) or
               (profile == "terran" and not unit_word_sprite_input_ready(
                   ROOT / ".local/sc64/terran-late/import-stage/sc64_race_sprites_generated.h")) or
               (profile in STAGED_CAMPAIGN_INPUTS and not race_campaign_input_ready(
                   profile, ROOT / ".local/sc64/zp-stage/generated/sc64_races_generated.h")) or
               any(not staged_campaign_input_ready(profile, label, path)
                   for label, path in paths
                   if any(label == item[0] for item in STAGED_CAMPAIGN_INPUTS.get(profile, ()))))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    doctor_parser = commands.add_parser("doctor", help="check required build/test tools; report optional mGBA")
    doctor_parser.add_argument("--emulator", action="store_true", help="also require mGBA for play or emulator checks")
    commands.add_parser("build", help="build and verify the default StarCraft ROM")
    commands.add_parser("test", help="run asset-free StarCraft host tests")
    play_parser = commands.add_parser("play", help="build and launch a StarCraft profile in mGBA")
    play_parser.add_argument("game", nargs="?", choices=GAMES, default="starcraft")
    sc64 = commands.add_parser("sc64", help="prepare or inspect optional local StarCraft 64 profiles")
    sc64.add_argument("action", choices=("prepare", "status", "build", "test", "play"))
    sc64.add_argument("--rom", type=Path, help="user-supplied USA N64 ROM (or ZIP) for prepare")
    sc64.add_argument("--profile", choices=SC64_PROFILES, default="unified")
    args = parser.parse_args()
    try:
        if args.command == "doctor":
            return doctor(args.emulator)
        if args.command == "build":
            build("starcraft")
            return 0
        if args.command == "test":
            run(["make", "test"])
            return 0
        if args.command == "play":
            return play(args.game)
        if args.action == "prepare":
            if args.rom is None:
                raise RuntimeError("sc64 prepare requires --rom PATH; the ROM is not downloaded")
            prepare(args.rom, args.profile)
        elif args.action == "status":
            return status(args.profile)
        elif args.action == "build":
            build(args.profile)
        elif args.action == "test":
            targets = SC64_TEST_TARGETS[args.profile]
            if isinstance(targets, tuple):
                run(["make", *targets])
            else:
                run(["make", targets])
        else:
            return play(args.profile)
        return 0
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
